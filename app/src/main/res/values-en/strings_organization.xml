    <!-- Collegare Google/Outlook e trovare il link iCal -->
    <string name="calendar_connect_section">Connect an account</string>
    <string name="calendar_connect_google">Connect Google Calendar</string>
    <string name="calendar_connect_outlook">Connect Outlook</string>
    <string name="calendar_connect_footer">An account added to the phone brings its calendars along: after you sign in they show up here on their own.</string>
    <string name="calendar_connect_outlook_title">Outlook calendars</string>
    <string name="calendar_connect_outlook_steps">1. Open the Outlook app and sign in.\n2. Tap your photo › Settings (gear) › your account.\n3. Turn on “Sync calendars”.\n\nCome back to KidBox: your Outlook calendars show up on their own.</string>
    <string name="calendar_connect_open_outlook">Open Outlook</string>
    <string name="calendar_connect_install_outlook">Install Outlook</string>
    <string name="calendar_feeds_help_title">How do I find the link?</string>
    <string name="calendar_feeds_help_google">Google Calendar, on a computer: calendar.google.com › Settings › pick the calendar on the left › “Integrate calendar” › copy the “Secret address in iCal format”.</string>
    <string name="calendar_feeds_help_outlook">Outlook, on a computer: outlook.com › Settings › Calendar › Shared calendars › “Publish a calendar” › pick the calendar and “Can view all details” › Publish › copy the ICS link.</string>
    <string name="calendar_feeds_help_other">School, team or gym: look on their website for “iCal”, “ICS”, “webcal” or “Add to calendar”.</string>
    <string name="calendar_feeds_help_privacy">The whole family sees the link: anyone who has it can read that calendar.</string>
