    <string name="settings_support_logs_full">For bugs, KidBox automatically attaches the app\'s diagnostic logs (the same ones used for crash reports).</string>
    <string name="settings_support_intro_full">This chat helps you get answers about KidBox and, if needed, to send a report to our team.</string>
